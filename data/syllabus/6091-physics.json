  "qualification": "Singapore-Cambridge General Certificate of Education (Ordinary Level)",
  "board": "SEAB / Cambridge",
  "syllabusYear": 2026,
  "language": "en",
  "sourceDocument": {
    "title": "Physics (Syllabus 6091)",
