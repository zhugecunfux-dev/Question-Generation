# Required only for LLM-based question generation (/api/generate with mode=llm).
# Template-variant generation and retrieval work without it.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model used for LLM generation.
# ANTHROPIC_MODEL=claude-opus-5

# Optional: override the SQLite file location (defaults to ./data/bank.sqlite).
# QG_DB_PATH=./data/bank.sqlite

# Required when the site is reachable from another computer. Use a long random value.
# QG_ACCESS_TOKEN=replace-with-a-long-random-secret

# Unsafe unless the server is bound to loopback. Never set this for Codespaces or remote use.
# QG_INSECURE_LOCAL_ONLY=1


# Codex uses your existing local ChatGPT login; no Platform API key is required.
# CODEX_WORKSPACE=/absolute/path/to/Question-Generation
# CODEX_BIN=codex
